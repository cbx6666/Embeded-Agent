# DeepSeek API 配置
# 请去 https://platform.deepseek.com/ 获取 API Key
DEEPSEEK_API_KEY=你的密钥填在这里
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
# deepseek-chat：对话快，适合语音（默认）
# deepseek-reasoner：推理慢，勿用于实时语音

# 以下为其他可选配置
# RAF_RESNET18_CKPT=
# WUJIE_VGG19_CKPT=
# WUJIE_OM_MODEL=models/wujie/wujie_vgg19_static.om
# EMBED_PERCEPTION_HZ=4
# EMBED_ESP32_SENSOR_PORT=/dev/ttyUSB0
# EMBED_ESP32_SENSOR_BAUD=115200
# EMBED_ENV_LOW_LIGHT_LUX=120
# EMBED_ENV_LOW_TEMPERATURE_C=18
# EMBED_ENV_DRY_HUMIDITY_PCT=30
# EMBED_ENV_NOISY_DB=65

# 百度语音（启用 --voice 时需要）
# BAIDU_ASR_API_KEY=
# BAIDU_ASR_SECRET_KEY=
# BAIDU_TTS_API_KEY=
# BAIDU_TTS_SECRET_KEY=
# BAIDU_TTS_APP_ID=

# 音频设备（录放分离：摄像头麦 + 独立扬声器）
# EMBED_VOICE_CAPTURE_ALSA_DEVICE=auto
# EMBED_TTS_ALSA_DEVICE=plughw:1,0
